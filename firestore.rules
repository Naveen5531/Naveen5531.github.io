rules_version = '2';
// Movana portal – security rules. Paste this whole file into
// Firebase console → Firestore Database → Rules, then press Publish.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(db)/documents/settings/owner; }
    function memberDoc() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function isMember() {
      return signedIn() && (isOwner() || (exists(memberDoc())
        && get(memberDoc()).data.status != 'Suspended'
        && get(memberDoc()).data.role != 'none'));
    }
    function role() { return get(memberDoc()).data.role; }
    // Everyone's roles: the main role plus any extra roles (a person can hold several; the highest access wins).
    function myRoles() { return get(memberDoc()).data.get('roles', []).concat([role()]); }
    // A members document may only list extra roles that are allowed for the main role written with it.
    function rolesOnly(d, allowed) { return d.get('roles', []).removeAll(allowed).size() == 0; }
    // Super admin and Admin head manage logins, roles and settings.
    function isAdmin() { return isOwner() || (isMember() && myRoles().hasAny(['superadmin', 'admin_head'])); }
    // Read-only roles can look but never change anything.
    function canWrite() { return isOwner() || (isMember() && myRoles().removeAll(['viewer', 'auditor', 'director']).size() > 0); }

    // ----- Punch (attendance app) -----
    // "employee" = staff who only use the Punch app: they see their own Punch data and nothing else in the portal.
    function isEmpOnly() { return isMember() && !isOwner() && myRoles().removeAll(['employee']).size() == 0; }
    function hasRole(list) { return isOwner() || (isMember() && myRoles().hasAny(list)); }
    // HR head, HR manager and HR executive (plus Super admin and Admin head) work on every employee's attendance and requests.
    function hrAll() { return hasRole(['superadmin', 'admin_head', 'hr_head', 'hr_manager', 'hr_exec', 'hr_sr', 'hr_tl', 'hr_am', 'hr_srm', 'hr_gm', 'hr_sgm', 'hr_avp', 'hr_vp', 'hr_svp']); }
    // Approving leave, comp off and attendance changes: not HR executive.
    function hrApprove() { return hasRole(['superadmin', 'admin_head', 'hr_head', 'hr_manager', 'hr_tl', 'hr_am', 'hr_srm', 'hr_gm', 'hr_sgm', 'hr_avp', 'hr_vp', 'hr_svp']); }
    // Salary: HR manager can see it, only HR head (and Super admin / Admin head) can change it.
    function salView() { return hasRole(['superadmin', 'admin_head', 'hr_head', 'hr_manager', 'hr_am', 'hr_srm', 'hr_gm', 'hr_sgm', 'hr_avp', 'hr_vp', 'hr_svp']); }
    function salEdit() { return hasRole(['superadmin', 'admin_head', 'hr_head', 'hr_gm', 'hr_sgm', 'hr_avp', 'hr_vp', 'hr_svp']); }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    // per-month documents are named <uid>_<yyyy-mm>
    function ownKey(id) { return signedIn() && id.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}'); }
    // Gmail sign-in: an admin approves an address (collection "gmail", document id = the address) with a role.
    function gmailDoc() { return /databases/$(db)/documents/gmail/$(request.auth.token.email.lower()); }
    function gmailOk(r) { return signedIn() && request.auth.token.email_verified == true && exists(gmailDoc()) && get(gmailDoc()).data.role == r; }
    function punchColl(c) { return c in ['punch_emp', 'punch_pay', 'punch_att', 'punch_mark', 'punch_req', 'punch_bal', 'punch_offer']; }

    // Employee profile for the app (designation, workplace, weekly offs …): HR keeps it, the employee reads their own.
    // Everyone signed in may read these basic profiles (Employee directory); salary is in punch_pay, not here.
    match /punch_emp/{uid} {
      allow read: if mine(uid) || hrAll() || isMember();
      allow write: if hrAll();
    }
    // Salary set-up: the employee reads their own (for their payslip); HR manager reads; HR head changes.
    match /punch_pay/{uid} {
      allow read: if mine(uid) || salView();
      allow write: if salEdit();
    }
    // Check-ins from the app, one document per employee per month. Only the employee writes their own.
    match /punch_att/{id} {
      allow read: if ownKey(id) || (signedIn() && resource.data.uid == request.auth.uid) || hrAll();
      allow create, update: if (ownKey(id) && request.resource.data.uid == request.auth.uid) || hrAll();
      allow delete: if hrAll();
    }
    // Attendance marked by HR (present, week off, holiday, leave, comp off …), one document per employee per month.
    match /punch_mark/{id} {
      allow read: if ownKey(id) || (signedIn() && resource.data.uid == request.auth.uid) || hrAll();
      allow write: if hrAll();
    }
    // Offer letters: HR (salary editors) prepare and release them; the employee reads their own once released and can only accept it.
    match /punch_offer/{uid} {
      allow read: if salView() || (mine(uid) && resource.data.status in ['Released', 'Accepted']);
      allow write: if salEdit();
      allow update: if salEdit() || (mine(uid) && resource.data.status == 'Released' && request.resource.data.status == 'Accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']));
    }
    // Leave and comp off balances as the employee's Punch app works them out: the app writes its own, HR reads all.
    match /punch_bal/{uid} {
      allow read: if mine(uid) || hrAll();
      allow write: if (mine(uid) && request.resource.data.uid == request.auth.uid) || hrAll();
    }
    // Leave, comp off and attendance-change requests.
    match /punch_req/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || hrAll();
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.s == 'Pending') || hrAll();
      // HR approves or rejects; the employee can only cancel their own pending request.
      allow update: if hrApprove()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.s == 'Pending'
            && request.resource.data.uid == request.auth.uid && request.resource.data.s in ['Pending', 'Cancelled']);
      allow delete: if hrApprove();
    }

    match /gmail/{em} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == em);
      allow write: if isAdmin();
    }

    // ----- People (HR system at /hr) -----
    // Shared lists: everyone signed in reads them, HR keeps them.
    match /hr_posts/{id} { allow read: if isMember(); allow write: if hrAll(); }
    match /hr_holidays/{id} { allow read: if isMember(); allow write: if hrAll(); }
    match /hr_jobs/{id} { allow read: if isMember(); allow write: if hrAll(); }
    match /hr_training/{id} { allow read: if isMember(); allow write: if hrAll(); }
    // Candidates are HR only.
    match /hr_cands/{id} { allow read, write: if hrAll(); }
    // Each person's own records (goals, reviews, training sign-ups, expenses, resignation, HR helpdesk): the person creates and reads their own,
    // can change them only while still open, and cannot close or approve them; HR reads and decides all.
    function hrOwnColl(c) { return c in ['hr_goals', 'hr_reviews', 'hr_enrol', 'hr_expenses', 'hr_exits', 'hr_help']; }
    function closedSt() { return ['Approved', 'Rejected', 'Paid', 'Closed', 'Completed', 'Final', 'Resolved']; }
    match /{coll}/{id} {
      allow read: if hrOwnColl(coll) && ((signedIn() && resource.data.uid == request.auth.uid) || hrAll());
      allow create: if hrOwnColl(coll) && ((signedIn() && request.resource.data.uid == request.auth.uid && !(request.resource.data.get('s', '') in closedSt())) || hrAll());
      allow update: if hrOwnColl(coll) && (hrAll() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && !(resource.data.get('s', '') in closedSt()) && !(request.resource.data.get('s', '') in closedSt())));
      allow delete: if hrOwnColl(coll) && (hrAll() || (signedIn() && resource.data.uid == request.auth.uid && !(resource.data.get('s', '') in closedSt())));
    }

    // "Is the portal set up yet?" – readable before login so the first screen knows what to show.
    match /public/{d} {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(db)/documents/public/setup);
      allow update, delete: if isAdmin();
    }

    // The owner is claimed once, by the first admin, and can never be changed from the app.
    match /settings/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /settings/{id} {
      allow read: if isMember();
      allow write: if id != 'owner' && isAdmin();
    }

    // Who has which role. Everyone signed in may read their own; admins manage all.
    match /members/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || (isMember() && !isEmpOnly()));
      allow create: if isAdmin()
        || (hrApprove() && request.resource.data.role == 'employee' && rolesOnly(request.resource.data, ['employee']))
        || (uid == request.auth.uid && gmailOk(request.resource.data.role) && rolesOnly(request.resource.data, [request.resource.data.role]))
        || (uid == request.auth.uid && !exists(ownerDoc())
            && getAfter(ownerDoc()).data.uid == request.auth.uid);
      allow update, delete: if isAdmin()
        || (hrApprove() && resource.data.role == 'employee' && rolesOnly(resource.data, ['employee']) && request.resource.data.role == 'employee' && rolesOnly(request.resource.data, ['employee']));
    }

    // Names and usernames for logins.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || hrApprove()
        || (uid == request.auth.uid && exists(memberDoc()) && gmailOk(get(memberDoc()).data.role))
        || (uid == request.auth.uid && !exists(memberDoc()) && !exists(ownerDoc()));
      allow delete: if isAdmin();
    }

    match /roles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Unique ticket ids: claimed once, never reused.
    match /ticketids/{id} {
      allow read: if canWrite();
      allow create: if canWrite();
      allow update: if canWrite() && resource.data.claimedBy == request.auth.uid;
      allow delete: if false;
    }

    // Everything else: shipments, pickups, trips, invoices, payments, staff, leave, payroll, tickets …
    // Punch employees are kept out of all of this; Punch data has its own rules above.
    match /{coll}/{id} {
      allow read: if isMember() && !isEmpOnly() && !punchColl(coll) && !coll.matches('hr_.*');
      allow write: if canWrite() && !isEmpOnly() && !punchColl(coll) && !coll.matches('hr_.*')
        && !(coll in ['members', 'roles', 'settings', 'users', 'public', 'ticketids', 'gmail']);
    }
  }
}
